# ===========================================
# cooking 项目环境变量模板（OPS-002）
# 单一来源：本文件是所有环境变量的唯一模板，后端不要另起一份
# ===========================================
#
# 【使用方式】Windows PowerShell（任选其一）
#   推荐：运行 .\06-devops\scripts\init-env.ps1
#         -> 按模板生成本机真实配置 06-devops/.env（密码与 JWT 自动生成随机值）
#         -> 并同步到 04-backend/server/.env（后端 dotenv 读取的那份）
#         -> 06-devops/.env 同时被 docker-compose.yml 自动读取作为 root / 应用库账号来源
#   手动：Copy-Item .\06-devops\.env.example .\06-devops\.env 再逐个替换占位值
#
# 【安全约定】（硬性，违反即视为事故）
#   1. 本文件只能放「占位值」，禁止填写真实密码 / Token / 密钥；
#   2. 真实配置只写在 04-backend/server/.env，该文件已被 .gitignore 忽略；
#   3. 新增变量必须同步更新本文件，写清用途、默认值与是否必填；
#   4. 交接或开源前执行自检：git check-ignore -v 04-backend/server/.env（应命中规则）。
#
# 【读取方式】后端 04-backend/server/src/config/index.js（dotenv）
# 【生效方式】改完 .env 需重启后端（nodemon 会自动重启）
# 【密钥生成】node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================

# -------------------------------------------
# 一、服务
# -------------------------------------------
# 运行环境：development | production（必填）
#   production 下关闭错误堆栈返回，日志级别收紧，见架构文档 5.5 / 第 8 节
NODE_ENV=development

# 后端监听端口（必填，约定 3000，勿改）
#   C 端 dev 8080、后台 dev 8081 通过 devServer proxy 转发到本端口
SERVER_PORT=3000

# 跨域白名单（必填）
#   逗号分隔的完整 Origin；开发期可用 * 图省事，上线前必须改为具体域名
#   示例：http://localhost:8080,http://localhost:8081
CORS_ORIGIN=*

# -------------------------------------------
# 二、数据库（MySQL 8）
# -------------------------------------------
# 主机（必填）：本机填 127.0.0.1；Docker Compose 容器内填服务名 mysql
DB_HOST=127.0.0.1

# 端口（必填）
#   本机 MySQL 默认 3306；走 Docker Compose 时宿主机映射为 3307（详见 06-devops/docker-compose.yml）
#   注意：容器内务端口始终是 3306，只有“从宿主机/本机 Node 进程连接”时才用 3307
DB_PORT=3307

# 用户名（必填）：建议用下面的 MYSQL_USER 应用账号，不要用 root
#   容器场景：root 仅用于初始化；应用账号由 MYSQL_USER / MYSQL_PASSWORD 自动创建并授权到 cooking 库
DB_USER=cooking

# 密码（必填，真实值严禁入库）：占位值，请在本机 .env 中替换
#   必须与服务容器内 MYSQL_PASSWORD 保持一致（本机 .env 是两者的唯一来源）
DB_PASSWORD=change_me

# 库名（必填）：需先手工建库 CREATE DATABASE cooking CHARACTER SET utf8mb4
DB_NAME=cooking

# 连接池最大连接数（可选，默认 10）：家庭场景并发极低，10 足够
DB_POOL_MAX=10

# -------------------------------------------
# 三、管理员账号（仅首次启动 seeder 使用）
# -------------------------------------------
# 初始管理员用户名（可选，默认 admin）
ADMIN_DEFAULT_USERNAME=admin

# 初始管理员密码（必填，真实值严禁入库）
#   仅用于首次 seeder 创建账号，创建完成后请立即改密，并把真实值从 .env 删除或加长随机化
ADMIN_DEFAULT_PASSWORD=change_me_please

# -------------------------------------------
# 四、鉴权（JWT）
# -------------------------------------------
# 签名密钥（必填，真实值严禁入库）：至少 32 位随机串
#   泄露等同于后台失守，必须每台部署机不同
JWT_SECRET=please_replace_with_a_random_string

# Token 有效期（可选，默认 12h）：支持 ms 风格字符串，如 12h / 720m
JWT_EXPIRES_IN=12h

# -------------------------------------------
# 五、文件上传
# -------------------------------------------
# 图片保存目录（可选，默认 uploads）
#   相对 04-backend/server 目录，也可填绝对路径；该目录已被 gitignore
UPLOAD_DIR=uploads

# 单个文件上限，单位字节（可选，默认 5242880 = 5MB）
#   需与前端校验一致，见 api-design.md 上传接口
UPLOAD_MAX_SIZE=5242880

# 允许的图片 MIME 白名单（可选，逗号分隔）
#   与架构文档 5.2 保持一致
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# 静态资源访问前缀（可选，默认留空）
#   留空 = 前端用同源地址（如 http://localhost:3000/uploads/xxx.jpg）
#   后续切换对象存储时填 CDN 域名，如 https://static.example.com
STATIC_BASE_URL=

# 是否生成缩略图（可选，默认 true）
#   true 需要 sharp；Windows 上 sharp 安装失败时改为 false，降级为原图直出（风险 T-01）
ENABLE_THUMBNAIL=true

# -------------------------------------------
# 六、推荐规则
# -------------------------------------------
# 推荐菜品数量（可选，默认 4，PRD 固定值为 4，勿随意改）
RECOMMEND_SIZE=4

# 排除最近 N 天内已点过的菜（可选，默认 7 天）
RECOMMEND_EXCLUDE_DAYS=7

# -------------------------------------------
# 七、日志
# -------------------------------------------
# 日志级别（可选，默认 info）：debug | info | warn | error
LOG_LEVEL=info

# 日志目录（可选，默认 logs）：相对 04-backend/server 目录，已被 gitignore
LOG_DIR=logs

# -------------------------------------------
# 八、Docker Compose 专用（OPS-004）
# -------------------------------------------
# 说明：docker compose 会自动读取 06-devops/.env 填充下面这些变量（编译要求见变量注释）
#       这些是「建容器那一刻」才生效的初始化参数；改完必须删卷重建才生效：
#         docker compose down -v && docker compose up -d mysql
#       它们只影响容器初始化，后端业务代码不读这些变量。

# MySQL root 密码（必填，真实值严禁入库）：容器首次初始化时设置
#   本机严禁用弱口令；生产环境应改为随机长串并只保存在部署机
MYSQL_ROOT_PASSWORD=change_me_root

# 容器启动时自动创建的业务库名（必填）：与上面的 DB_NAME 保持一致
#   只在数据卷为空（首次启动）时执行
MYSQL_DATABASE=cooking

# 应用账号（必填）：容器初始化时自动创建，并被授予 cooking 库的读写权限
#   后端用 DB_USER / DB_PASSWORD 连的就是这个账号，别直接用 root
MYSQL_USER=cooking

# 应用账号密码（必填，真实值严禁入库）：必须与上面的 DB_PASSWORD 完全一致
MYSQL_PASSWORD=change_me

# Compose 项目名（可选，默认 cooking）：影响容器名 / 网络名 / 卷名前缀
#   同机部署多套环境（如 dev / staging）时用不同的名字隔离
COMPOSE_PROJECT_NAME=cooking

# ===========================================
# 附：上线 / 交接前自检清单
#   [ ] JWT_SECRET 已替换为随机串（非占位值）
#   [ ] DB_PASSWORD、MYSQL_PASSWORD、MYSQL_ROOT_PASSWORD、ADMIN_DEFAULT_PASSWORD 已替换为强密码
#   [ ] CORS_ORIGIN 已改为具体域名（不再是 *）
#   [ ] NODE_ENV=production
#   [ ] 04-backend/server/.env 未被 Git 跟踪
#   [ ] git ls-files | grep -E '(^|/)\.env$' 结果为空
# ===========================================
