{
  "name": "cooking",
  "version": "0.1.0",
  "private": true,
  "description": "家庭点菜小程序（cooking）工程根目录。此处只放运维脚本入口，不放业务代码；三个业务工程分别在 03-frontend/mobile、03-frontend/admin、04-backend/server。",
  "scripts": {
    "env:init": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/init-env.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/start-dev.ps1",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/start-dev.ps1 -WithMobile -WithAdmin",
    "dev:ossl": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/start-dev.ps1 -LegacyOpenSsl",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/stop-dev.ps1",
    "db:image": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/pull-db-image.ps1",
    "db:up": "docker compose -f ./06-devops/docker-compose.yml up -d mysql",
    "db:down": "docker compose -f ./06-devops/docker-compose.yml stop mysql",
    "db:restart": "docker compose -f ./06-devops/docker-compose.yml restart mysql",
    "db:logs": "docker compose -f ./06-devops/docker-compose.yml logs --tail 100 mysql",
    "db:ps": "docker compose -f ./06-devops/docker-compose.yml ps",
    "db:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/db-check.ps1 -Wait",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/backup.ps1",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/restore.ps1",
    "db:drill": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/backup-drill.ps1",
    "ops:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/check-scripts.ps1",
    "ops:git-init": "powershell -NoProfile -ExecutionPolicy Bypass -File ./06-devops/scripts/git-init.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
